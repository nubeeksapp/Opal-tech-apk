# Opal Tech Android Environment Configuration
#
# Client configuration (Supabase URL and anonymous public client key) are safely
# configured via BuildConfig fields in app/build.gradle.kts.
#
# No secret API keys are required or stored in this repository.
# If you wish to provide local development overrides, create a private .env file:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
